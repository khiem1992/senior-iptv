<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_channel_normal"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:focusable="true"
    android:clickable="true">

    <!-- Số kênh 2 chữ số -->
    <TextView
        android:id="@+id/tvChannelNumber"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:text="01"
        android:textColor="#94A3B8"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Logo kênh (Có bo góc và fallback an toàn không crash) -->
    <ImageView
        android:id="@+id/ivChannelLogo"
        android:layout_width="54dp"
        android:layout_height="36dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_tv_placeholder"
        android:layout_marginEnd="14dp" />

    <!-- Tên kênh chữ lớn -->
    <TextView
        android:id="@+id/tvChannelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="VTV1 HD"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="marquee" />

    <!-- Chấm tròn báo kênh đang phát -->
    <View
        android:id="@+id/viewActiveDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_active_dot"
        android:visibility="gone"
        android:layout_marginStart="8dp" />

</LinearLayout>
